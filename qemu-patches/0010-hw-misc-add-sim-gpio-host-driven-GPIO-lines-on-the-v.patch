+++ b/hw/misc/meson.build
@@ -6,6 +6,7 @@ system_ss.add(when: 'CONFIG_ISA_TESTDEV', if_true: files('pc-testdev.c'))
 system_ss.add(when: 'CONFIG_PCI_TESTDEV', if_true: files('pci-testdev.c'))
 system_ss.add(when: 'CONFIG_UNIMP', if_true: files('unimp.c'))
 system_ss.add(when: 'CONFIG_SIM_CLOCK', if_true: files('sim_clock.c'))
+system_ss.add(when: 'CONFIG_SIM_GPIO', if_true: files('sim_gpio.c'))
 system_ss.add(when: 'CONFIG_EMPTY_SLOT', if_true: files('empty_slot.c'))
 system_ss.add(when: 'CONFIG_LED', if_true: files('led.c'))
 system_ss.add(when: 'CONFIG_PVPANIC_COMMON', if_true: files('pvpanic.c'))
diff --git a/hw/misc/sim_gpio.c b/hw/misc/sim_gpio.c
new file mode 100644
index 0000000..4d9fc3f
--- /dev/null
+++ b/hw/misc/sim_gpio.c
@@ -0,0 +1,284 @@
+/*
+ * Host-driven GPIO lines on the virtual clock ("sim-gpio")
+ *
+ * A board wires the device's outputs to pads it wants a host process to
+ * drive (buttons, data-ready lines, chip selects of other boards) and its
+ * inputs to pads the host wants to watch (LEDs, enables).  The host
+ * schedules level changes at QEMU_CLOCK_VIRTUAL timestamps; a virtual-clock
+ * timer applies them, so under -icount the guest sees an input change at
+ * the same instruction on every run.  Every change of a watched line is
+ * reported with its virtual time.  The device never waits for the host to
+ * drive a line.
+ *
+ * Host to device, one command per line:
+ *   L <virtual_ns> <line> <0|1>
+ *       drive output <line> to the level at virtual time <virtual_ns>;
+ *       times in the past (including 0) apply immediately.
+ *   S <seq>
+ *       reply "A <seq> <now_ns>" once all earlier lines are processed.
+ * Device to host:
+ *   A <seq> <now_ns>             sync acknowledgement
+ *   O <now_ns> <line> <0|1>      watched input <line> changed level
+ *   E <message>                  malformed command
+ *
+ * Change reports are written with a blocking write: they form the record
+ * of what the guest did, and dropping one would make it non-reproducible.
+ *
+ * Copyright (c) 2026 Romeo Mattar
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/cutils.h"
+#include "qemu/timer.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-core.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "hw/misc/sim_gpio.h"
+#include "chardev/char-fe.h"
+#include "migration/vmstate.h"
+#include "qom/object.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(SimGpioState, SIM_GPIO)
+
+#define SIM_GPIO_MAX_LINES  64
+#define SIM_GPIO_LINE_MAX   128
+#define SIM_GPIO_MAX_PENDING (1 << 20)
+
+typedef struct SimGpioUpdate {
+    int64_t when_ns;
+    unsigned line;
+    bool level;
+} SimGpioUpdate;
+
+struct SimGpioState {
+    DeviceState parent_obj;
+
+    CharBackend chr;
+    QEMUTimer *timer;
+    GQueue pending;             /* SimGpioUpdate *, sorted by when_ns */
+    qemu_irq drive[SIM_GPIO_MAX_LINES];
+    uint64_t driven;            /* levels currently driven */
+    uint64_t sensed;            /* last levels seen on the inputs */
+
+    char line[SIM_GPIO_LINE_MAX];
+    unsigned line_len;
+    bool line_overflow;
+
+    uint32_t nlines;
+};
+
+static void sim_gpio_send(SimGpioState *s, bool reliable, const char *fmt, ...)
+    G_GNUC_PRINTF(3, 4);
+
+static void sim_gpio_send(SimGpioState *s, bool reliable, const char *fmt, ...)
+{
+    g_autofree char *msg = NULL;
+    va_list ap;
+
+    if (!qemu_chr_fe_backend_connected(&s->chr)) {
+        return;
+    }
+    va_start(ap, fmt);
+    msg = g_strdup_vprintf(fmt, ap);
+    va_end(ap);
+    if (reliable) {
+        qemu_chr_fe_write_all(&s->chr, (const uint8_t *)msg, strlen(msg));
+    } else {
+        qemu_chr_fe_write(&s->chr, (const uint8_t *)msg, strlen(msg));
+    }
+}
+
+static void sim_gpio_apply(SimGpioState *s, unsigned line, bool level)
+{
+    s->driven = deposit64(s->driven, line, 1, level);
+    qemu_set_irq(s->drive[line], level);
+}
+
+static void sim_gpio_rearm(SimGpioState *s)
+{
+    SimGpioUpdate *head = g_queue_peek_head(&s->pending);
+
+    if (head) {
+        timer_mod(s->timer, head->when_ns);
+    } else {
+        timer_del(s->timer);
+    }
+}
+
+static void sim_gpio_timer_cb(void *opaque)
+{
+    SimGpioState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    SimGpioUpdate *u;
+
+    while ((u = g_queue_peek_head(&s->pending)) && u->when_ns <= now) {
+        g_queue_pop_head(&s->pending);
+        sim_gpio_apply(s, u->line, u->level);
+        g_free(u);
+    }
+    sim_gpio_rearm(s);
+}
+
+static gint sim_gpio_update_cmp(gconstpointer a, gconstpointer b,
+                                gpointer opaque)
+{
+    const SimGpioUpdate *ua = a, *ub = b;
+
+    /* Equal timestamps keep arrival order (g_queue_insert_sorted is stable) */
+    return ua->when_ns < ub->when_ns ? -1 : ua->when_ns > ub->when_ns;
+}
+
+static void sim_gpio_command(SimGpioState *s, char *cmd)
+{
+    g_auto(GStrv) f = g_strsplit_set(g_strstrip(cmd), " \t", -1);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    guint n = g_strv_length(f);
+
+    if (n == 0 || !f[0][0]) {
+        return;
+    }
+    if (!strcmp(f[0], "S") && n == 2) {
+        sim_gpio_send(s, false, "A %s %" PRId64 "\n", f[1], now);
+    } else if (!strcmp(f[0], "L") && n == 4) {
+        int64_t when, line, level;
+        SimGpioUpdate *u, *tail;
+
+        if (qemu_strtoi64(f[1], NULL, 10, &when) ||
+            qemu_strtoi64(f[2], NULL, 10, &line) ||
+            qemu_strtoi64(f[3], NULL, 10, &level) ||
+            line < 0 || line >= s->nlines || (level != 0 && level != 1)) {
+            sim_gpio_send(s, false, "E bad L command\n");
+            return;
+        }
+        if (when <= now) {
+            sim_gpio_apply(s, line, level);
+            return;
+        }
+        if (g_queue_get_length(&s->pending) >= SIM_GPIO_MAX_PENDING) {
+            sim_gpio_send(s, false, "E update queue full\n");
+            return;
+        }
+        u = g_new0(SimGpioUpdate, 1);
+        u->when_ns = when;
+        u->line = line;
+        u->level = level;
+        tail = g_queue_peek_tail(&s->pending);
+        if (!tail || tail->when_ns <= u->when_ns) {
+            g_queue_push_tail(&s->pending, u);
+        } else {
+            g_queue_insert_sorted(&s->pending, u, sim_gpio_update_cmp, NULL);
+        }
+        sim_gpio_rearm(s);
+    } else {
+        sim_gpio_send(s, false, "E unknown command\n");
+    }
+}
+
+static int sim_gpio_can_receive(void *opaque)
+{
+    SimGpioState *s = opaque;
+
+    return SIM_GPIO_LINE_MAX - s->line_len;
+}
+
+static void sim_gpio_receive(void *opaque, const uint8_t *buf, int size)
+{
+    SimGpioState *s = opaque;
+    int i;
+
+    for (i = 0; i < size; i++) {
+        if (buf[i] == '\n') {
+            s->line[s->line_len] = '\0';
+            if (s->line_overflow) {
+                sim_gpio_send(s, false, "E line too long\n");
+            } else {
+                sim_gpio_command(s, s->line);
+            }
+            s->line_len = 0;
+            s->line_overflow = false;
+        } else if (s->line_len < SIM_GPIO_LINE_MAX - 1) {
+            s->line[s->line_len++] = buf[i];
+        } else {
+            s->line_overflow = true;
+        }
+    }
+}
+
+static void sim_gpio_sense(void *opaque, int n, int level)
+{
+    SimGpioState *s = opaque;
+    bool l = level != 0;
+
+    if (extract64(s->sensed, n, 1) == l) {
+        return;
+    }
+    s->sensed = deposit64(s->sensed, n, 1, l);
+    sim_gpio_send(s, true, "O %" PRId64 " %d %d\n",
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), n, l);
+}
+
+static void sim_gpio_realize(DeviceState *dev, Error **errp)
+{
+    SimGpioState *s = SIM_GPIO(dev);
+
+    if (s->nlines == 0 || s->nlines > SIM_GPIO_MAX_LINES) {
+        error_setg(errp, "lines must be between 1 and %d",
+                   SIM_GPIO_MAX_LINES);
+        return;
+    }
+    qdev_init_gpio_in(dev, sim_gpio_sense, s->nlines);
+    qdev_init_gpio_out(dev, s->drive, s->nlines);
+    g_queue_init(&s->pending);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, sim_gpio_timer_cb, s);
+    qemu_chr_fe_set_handlers(&s->chr, sim_gpio_can_receive, sim_gpio_receive,
+                             NULL, NULL, s, NULL, true);
+}
+
+static void sim_gpio_unrealize(DeviceState *dev)
+{
+    SimGpioState *s = SIM_GPIO(dev);
+
+    qemu_chr_fe_deinit(&s->chr, false);
+    timer_free(s->timer);
+    g_queue_clear_full(&s->pending, g_free);
+}
+
+static const VMStateDescription vmstate_sim_gpio = {
+    .name = TYPE_SIM_GPIO,
+    /* Pending host updates live outside the guest state */
+    .unmigratable = 1,
+};
+
+static Property sim_gpio_properties[] = {
+    DEFINE_PROP_CHR("chardev", SimGpioState, chr),
+    DEFINE_PROP_UINT32("lines", SimGpioState, nlines, 40),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void sim_gpio_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "GPIO lines driven and watched by a host over a chardev";
+    dc->realize = sim_gpio_realize;
+    dc->unrealize = sim_gpio_unrealize;
+    dc->vmsd = &vmstate_sim_gpio;
+    device_class_set_props(dc, sim_gpio_properties);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo sim_gpio_types[] = {
+    {
+        .name          = TYPE_SIM_GPIO,
+        .parent        = TYPE_DEVICE,
+        .instance_size = sizeof(SimGpioState),
+        .class_init    = sim_gpio_class_init,
+    },
+};
+
+DEFINE_TYPES(sim_gpio_types)
diff --git a/include/hw/misc/sim_gpio.h b/include/hw/misc/sim_gpio.h
new file mode 100644
index 0000000..32c4da6
--- /dev/null
+++ b/include/hw/misc/sim_gpio.h
@@ -0,0 +1,17 @@
+/*
+ * Host-driven GPIO lines on the virtual clock ("sim-gpio")
+ *
+ * Unnamed GPIO outputs: levels driven by the host.
+ * Unnamed GPIO inputs: levels reported to the host on every change.
+ *
+ * Copyright (c) 2026 Romeo Mattar
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_SIM_GPIO_H
+#define HW_MISC_SIM_GPIO_H
+
+#define TYPE_SIM_GPIO "sim-gpio"
+
+#endif
-- 
